# A Solana mainnet RPC URL that serves getProgramAccounts and transaction version 1 (QuickNode, Helius, Triton...).
# Copy to .env and fill in. Never commit .env.
B2_RPC=
# The indexer's port (the web app proxies /api and /rpc to it in development).
PORT=8787
# Optional: the router's integrator fee on every swap's SOL leg (1 to 100 bps; Bordrless keeps a fifth).
# The wallet must already hold at least rent (about 0.001 SOL). Leave empty for no fee. Pools quoted in
# bridged SOL carry the fee too once the wallet has a bridged SOL holding.
B2_FEE_WALLET=
B2_FEE_BPS=50
